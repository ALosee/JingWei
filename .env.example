NODE_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
DATABASE_URL=postgres://jingwei:jingwei@127.0.0.1:5432/jingwei
APP_ORIGIN=http://localhost:5173
HTTP_TRUST_PROXY=false
