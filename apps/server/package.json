{
  "name": "@jingwei/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env.development --env-file-if-exists=../../.env.development.local src/index.ts",
    "dev:test": "tsx watch --env-file=../../.env.test src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@jingwei/audit": "workspace:*",
    "@jingwei/auth": "workspace:*",
    "@jingwei/config": "workspace:*",
    "@jingwei/database": "workspace:*",
    "@jingwei/kernel": "workspace:*",
    "@jingwei/module-dictionary": "workspace:*",
    "@jingwei/module-iam": "workspace:*",
    "@jingwei/module-navigation": "workspace:*",
    "@jingwei/module-organization": "workspace:*",
    "@jingwei/module-sdk": "workspace:*",
    "@jingwei/observability": "workspace:*",
    "@jingwei/outbox": "workspace:*",
    "argon2": "catalog:",
    "hono": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
