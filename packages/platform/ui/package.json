{
  "name": "@jingwei/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#ui/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./src/public.d.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css",
    "./theme-init": "./src/theme/init.ts",
    "./theme-unocss": "./src/theme/semantic-colors.ts",
    "./layout-unocss": {
      "types": "./src/styles/layout-unocss.d.ts",
      "default": "./src/styles/layout-unocss.ts"
    },
    "./theme-palette": "./src/patterns/theme-palette/theme-palette.ts"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@iconify/vue": "catalog:",
    "@soybeanjs/colord": "catalog:",
    "@soybeanjs/cva": "catalog:",
    "@vean/aria": "catalog:",
    "@vean/theme": "catalog:",
    "@soybeanjs/utils": "catalog:",
    "@vueuse/core": "catalog:",
    "@tanstack/vue-virtual": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vue-tsc": "catalog:",
    "vite": "catalog:"
  }
}
